---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout title={`Page not found — ${site.name}`} description="That page does not exist.">
  <div class="page page-narrow">
    <main>
      <h1 class="not-found-title">Page not found</h1>
      <p class="not-found-copy">That URL doesn’t exist on this site.</p>
      <a class="not-found-link" href="/">← Back home</a>
    </main>
  </div>
</BaseLayout>
